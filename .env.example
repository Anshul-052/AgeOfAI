# Environment variables declared in this file are automatically made available to Prisma.

# Supabase PostgreSQL. Use the session pooler (port 5432) for local development
# and migrations. Use the transaction pooler (port 6543) for serverless hosting.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
DATABASE_POOL_SIZE="1"
SQLITE_SOURCE_URL="file:./dev.db"

# GOOGLE GEMINI API KEY FOR AI STORY DRAFTING & TOKEN TRACKING
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-flash-latest"
GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"

# Optional deeper source discovery for the autonomous editor.
# Until configured, specialist feeds plus Google News RSS are used.
TAVILY_API_KEY="tvly-YourTavilyKeyHere"
EDITOR_LOOKBACK_DAYS="8"
EDITOR_MAX_PER_DOMAIN="2"
EDITOR_MIN_STORIES="8"
EDITOR_SEARCH_DISCOVERY="true"

# Leave unset to disable every admin page and mutation endpoint (recommended).
# Set to a long random value only when temporary admin access is required.
ADMIN_ACCESS_KEY="replace-with-a-long-random-secret"

# RESEND API KEY FOR NEWSLETTER DISPATCH (OPTIONAL)
RESEND_API_KEY="re_YourResendApiKeyHere"
NEWSLETTER_FROM="AgeOfAI <newsletter@example.com>"
NEWSLETTER_UNSUBSCRIBE_SECRET="replace-with-at-least-32-random-characters"

# PRODUCT HUNT API TOKEN FOR STARTUP/WEB DEV INGESTION (OPTIONAL)
PRODUCT_HUNT_TOKEN="ph_YourProductHuntTokenHere"

# BASE URL FOR NEWSLETTER LINKS & OPENGRAPH CARDS
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
